{
  "$comment": "Raiz del monorepo ProyectoHV. Sin dependencias: los scripts usan solo Node nativo. Cada componente (web/, services/, functions/) tiene su propio package.json o build.",
  "name": "proyectohv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portafolio tecnico de Harold Augusto Rodriguez Martinez, y exhibit del proceso con el que fue construido.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:ai": "node tools/bootstrap.mjs",
    "setup:ai:dry": "node tools/bootstrap.mjs --dry-run",
    "verify:context": "node tools/verify-context.mjs",
    "guardrails": "node .agents/skills/hv-guardrails/scripts/run-guardrails.mjs",
    "guardrails:all": "node .agents/skills/hv-guardrails/scripts/run-guardrails.mjs --all",
    "validate:content": "node .agents/skills/hv-career-pipeline/scripts/validate-career-data.mjs",
    "verify:mcp": "node tools/verify-mcp.mjs",
    "verify:mcp:probe": "node tools/verify-mcp.mjs --probe",
    "publish:confluence": "node tools/publish-confluence.mjs",
    "build:content": "node .agents/skills/hv-career-pipeline/scripts/build-career-data.mjs",
    "build:content:dry": "node .agents/skills/hv-career-pipeline/scripts/build-career-data.mjs --dry-run",
    "sonar:up": "docker compose -f infra/sonar/docker-compose.yml up -d",
    "sonar:down": "docker compose -f infra/sonar/docker-compose.yml down",
    "sonar:logs": "docker compose -f infra/sonar/docker-compose.yml logs -f",
    "sonar:status": "node infra/sonar/check-status.mjs",
    "sonar:rules": "node infra/sonar/configure-quality-profiles.mjs",
    "sonar:scan": "node infra/sonar/run-scanner.mjs",
    "jenkins:up": "docker compose -f infra/jenkins/docker-compose.yml up -d",
    "jenkins:down": "docker compose -f infra/jenkins/docker-compose.yml down",
    "jenkins:logs": "docker compose -f infra/jenkins/docker-compose.yml logs -f",
    "jenkins:status": "node infra/jenkins/check-status.mjs",
    "sonar:gate": "node pipelines/checks/sonar-gate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hamartinez9408/ProyectoHV.git"
  }
}
